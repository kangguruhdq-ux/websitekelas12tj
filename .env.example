# ==============================================================================
# ENVIRONMENT VARIABLES: PORTAL KELAS XII TKJ
# ==============================================================================

# SUPABASE CONFIGURATION (OPSIONAL - APLIKASI MEMILIKI FALLBACK OTOMATIS)
# Jika dikosongkan, aplikasi tetap 100% berfungsi normal dengan server JSON database lokal & data URL storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# KREDENSIAL LOGIN ADMIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# NEON POSTGRESQL / SERVERLESS DATABASE (DIREKOMENDASIKAN UNTUK DEPLOY VERCEL)
# Masukkan connection string dari Neon DB Anda agar perubahan CMS tersimpan permanen di cloud
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
